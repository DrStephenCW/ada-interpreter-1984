#!/bin/sh
# Run Arcturus 1.6-A.  Uses the binary built here (./ada), or the prebuilt
# one in bin/ for this machine, and the run-time files in lib/.
here=$(cd "$(dirname "$0")" && pwd)
ARCTURUS_LIB="$here/lib/"; export ARCTURUS_LIB
if [ -x "$here/ada" ]; then exec "$here/ada" "$@"; fi
case $(uname -m) in
aarch64|arm64)	exec "$here/bin/ada-aarch64-static" "$@" ;;
x86_64|amd64)	exec "$here/bin/ada-x86_64-static" "$@" ;;
i?86)		exec "$here/bin/ada-i386-static" "$@" ;;
*)		echo "arcturus: no prebuilt binary for $(uname -m); run make" >&2; exit 1 ;;
esac
