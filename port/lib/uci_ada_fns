package uci is

-- flags hooked into ada interpreter
intdebug: boolean := false;	-- prints each node as it is interpreted
counting : boolean := false;    -- indicates whether we're counting node visits
                                -- during evaluation.
croak_ok : boolean := false;	-- procedure die only works if this is true;
				-- for people who don't want to kill themselves
				-- accidentally (say by mistyping "dir").
write_core_file : boolean := false;
				-- if true then when quitting we should write
				-- a core file along with the ADA.SAVE file
				-- (helps keep 'em in sync).

-- subr's initialized by init() 

procedure history(filename : string := "/dev/tty");
procedure export;
procedure die;
procedure save(filename : string := "ada.core");
procedure restore(filename : string := "ada.core");
procedure include(filename: string);
procedure include_commands(filename: string);
procedure load(filename: string);
procedure fix;
procedure news;              
procedure memreport;
procedure treesize(s : symbol);
procedure profile_on;
procedure profile_off;
procedure stack_trace;
procedure symbol_table(s: symbol := usr'sym);
procedure static_link(s: symbol);
procedure csh(s : string := ""; term_save : boolean := true);
procedure edit(x: symbol);
procedure rm(x: symbol);
procedure where;
procedure how;
procedure printall;        
procedure touch(sym : symbol);
procedure cref( sym: symbol;
		filename: string := "";
		nroff: boolean := false);
procedure bktr(depth: integer := integer'last);
procedure putsym(sym : symbol);
procedure quit(write_core : boolean := write_core_file);

-- procedures for text objects
procedure type_out(t: string);
procedure textedit(t: string);

procedure break;
procedure dumpcore;

procedure clear_counters;       -- clear all counters.

--. procedures for questions and bug reports

procedure bug;		-- make a bug report
procedure question;	-- ask a question

end uci;

package body uci is

procedure getstr(item : in out string) is 
	point : integer := item'first;
	ch : character;
begin
	getchr(ch);
	while point <= item'last and then ch /= ascii.lf loop
	  item(point) := ch;
	  getchr(ch);
	  point := point + 1;
	end loop;
	if point < item'last then item(point) := character'val(0);
	end if;
end;

procedure news is
begin
  csh("more ~darpa/ada_news");   -- For use on uciunix machine for information
				 --- on system updates. 
end;

end uci;
