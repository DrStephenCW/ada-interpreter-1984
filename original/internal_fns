package internal_fns is
    use pp_functions;

-- These functions are hooked into the ada interpreter.
-- They will go away when it is possible to load code which references
--- C symbols in the base system.

type t_nodep is access integer;

type parser_constructs is (
	interactive_input, expression, name, declarative_part,
	sequence_of_statements, type_definition, subtype_indication,
	compilation );

function t_parse(s: string; construct: parser_constructs) return t_nodep;
procedure t_eval(p: t_nodep);
procedure t_pp( p: t_nodep;
		filename: string := "";
		nroff: boolean := pp_nroff;
		vert_bars: boolean := pp_vert_bars;
		comments: boolean := pp_comments;
		attachments: boolean := pp_attachments;
		width: integer range 40..120 := pp_width;
		attach_column: integer range 30..110 := pp_attach_column;
		color: pp_color_use := pp_color;
		identifiers: pp_capitalize := pp_identifiers;
		reserved_words: pp_capitalize := pp_reserved_words;
		number: boolean := pp_number;
		indent: integer range 0..10 := pp_indent;
		export: boolean := pp_export);
procedure t_ifp( p: t_nodep;
		filename: string := "";
		nroff: boolean := false;
		vert_bars: boolean := false;
		comments: boolean := true;
		attachments: boolean := false;
		width: integer range 40..120 := 70;
		attach_column: integer range 30..110 := 40);
function t_copytree( p: t_nodep) return t_nodep;
procedure t_macro_subst( p: in out t_nodep);
procedure t_expand(sym: symbol);	-- for package castor
procedure t_unexpand(sym: symbol);
function t_int_form(sym: symbol) return t_nodep;
function t_body_int_form(sym: symbol) return t_nodep;

end internal_fns;
